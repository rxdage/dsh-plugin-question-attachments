{
    "name":  "dsh-plugin-question-attachments",
    "version":  "0.1.4",
    "description":  "Attach images/files while answering an ask_user_question card: drop, paste or pick a file and it is sent to the agent as a steering prompt.",
    "keywords":  [
                     "dsh-plugin",
                     "dsh-plugins",
                     "deepseek-harness",
                     "deepseek",
                     "dsh",
                     "ask-user-question",
                     "question-attachments",
                     "answer-attachments",
                     "file-attachments",
                     "attachments",
                     "attachment",
                     "file-upload",
                     "image-upload",
                     "image-attachment",
                     "human-in-the-loop",
                     "hitl",
                     "ai-agent",
                     "agent-ui",
                     "client-plugin",
                     "chat-ui",
                     "web",
                     "desktop"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/rxdage/dsh-plugin-question-attachments.git"
                   },
    "homepage":  "https://github.com/rxdage/dsh-plugin-question-attachments#readme",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "cordis.patch.yml"
              ],
    "dsh":  {
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                          ],
                               "immediately":  true
                           },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "license":  "MIT"
}